<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codev.Avalonia.ViewModels"
        xmlns:core="using:Codev"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        x:Class="Codev.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/codev-icon.ico"
        KeyDown="MainWindow_KeyDown"
        Title="Codev"
        Width="1440" Height="960" MinWidth="1000" MinHeight="650"
        FontFamily="{Binding UiFontFamily}" FontSize="{Binding UiFontSize}"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.soft">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.soft:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.composer-send">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.composer-send:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBox.composer">
            <Setter Property="Background" Value="{DynamicResource ComposerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15,13" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="242,*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,17,12,12">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Grid ColumnDefinitions="30,*" Margin="5,0,3,20">
                    <Border Width="25" Height="25" CornerRadius="8" Background="#D97757" VerticalAlignment="Center">
                        <TextBlock Text="c" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="codev" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="YOUR LOCAL CODING SPACE" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="1" Classes="nav" Content="＋   New conversation" Command="{Binding NewConversationCommand}" Background="#D97757" Foreground="White" Margin="0,0,0,4" />
                <TextBox x:Name="SearchTextBox" Grid.Row="2" Classes="search" Watermark="⌕  Search conversations" Text="{Binding SearchText, Mode=TwoWay}" Margin="0,0,0,14" />
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <Button Classes="nav" Content="{Binding PinnedConversationsSectionLabel}" Click="TogglePinnedConversations_Click" FontSize="10" FontWeight="SemiBold" Padding="9,4" />
                        <ItemsControl ItemsSource="{Binding PinnedConversations}" IsVisible="{Binding PinnedConversationsExpanded}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Conversation">
                                <StackPanel>
                                    <Button Classes="nav" Content="{Binding Title}" Command="{Binding $parent[Window].DataContext.SelectConversationCommand}" CommandParameter="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Fork conversation" Tag="{Binding}" Click="ForkConversation_Click" />
                                                <MenuItem Header="Create isolated child session" ToolTip.Tip="Starts from committed HEAD on a separate Git branch; uncommitted changes stay in the parent checkout." Tag="{Binding}" Click="CreateChildSession_Click" />
                                                <MenuItem Header="Rename…" Tag="{Binding}" Click="RenameConversation_Click" />
                                                <MenuItem Header="Archive / restore" Tag="{Binding}" Click="ArchiveConversation_Click" />
                                                <MenuItem Header="Delete permanently…" Tag="{Binding}" Click="DeleteConversation_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Expander Header="{Binding ChildConversationsLabel}" IsExpanded="{Binding ChildConversationsExpanded, Mode=TwoWay}" IsVisible="{Binding HasChildConversations}" Margin="10,0,0,3" FontSize="10">
                                        <ItemsControl ItemsSource="{Binding ChildConversations}">
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Conversation">
                                                <Button Classes="nav" Content="{Binding ChildConversationLabel}" Padding="12,5" Command="{Binding $parent[Window].DataContext.SelectConversationCommand}" CommandParameter="{Binding}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Rename…" Tag="{Binding}" Click="RenameConversation_Click" />
                                                            <MenuItem Header="Delete permanently…" Tag="{Binding}" Click="DeleteConversation_Click" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="nav" Content="{Binding ArchiveViewLabel}" Command="{Binding ToggleArchiveViewCommand}" Margin="1,12,0,0" />
                        <Button Classes="nav" Content="{Binding RecentConversationsSectionLabel}" Click="ToggleRecentConversations_Click" FontSize="10" FontWeight="SemiBold" Padding="9,4" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding RecentConversations}" IsVisible="{Binding RecentConversationsExpanded}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Conversation">
                                <StackPanel>
                                    <Button Classes="nav" Content="{Binding Title}" Command="{Binding $parent[Window].DataContext.SelectConversationCommand}" CommandParameter="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Fork conversation" Tag="{Binding}" Click="ForkConversation_Click" />
                                                <MenuItem Header="Create isolated child session" ToolTip.Tip="Starts from committed HEAD on a separate Git branch; uncommitted changes stay in the parent checkout." Tag="{Binding}" Click="CreateChildSession_Click" />
                                                <MenuItem Header="Rename…" Tag="{Binding}" Click="RenameConversation_Click" />
                                                <MenuItem Header="Archive / restore" Tag="{Binding}" Click="ArchiveConversation_Click" />
                                                <MenuItem Header="Delete permanently…" Tag="{Binding}" Click="DeleteConversation_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Expander Header="{Binding ChildConversationsLabel}" IsExpanded="{Binding ChildConversationsExpanded, Mode=TwoWay}" IsVisible="{Binding HasChildConversations}" Margin="10,0,0,3" FontSize="10">
                                        <ItemsControl ItemsSource="{Binding ChildConversations}">
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Conversation">
                                                <Button Classes="nav" Content="{Binding ChildConversationLabel}" Padding="12,5" Command="{Binding $parent[Window].DataContext.SelectConversationCommand}" CommandParameter="{Binding}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Rename…" Tag="{Binding}" Click="RenameConversation_Click" />
                                                            <MenuItem Header="Delete permanently…" Tag="{Binding}" Click="DeleteConversation_Click" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="4" Spacing="1" Margin="0,0,0,8">
                    <Button Classes="nav" Content="☁  Connect hosted models…" Click="ConfigureCloudProvider_Click" ToolTip.Tip="Connect OpenAI or Anthropic using an API key; cloud requests require an explicit acknowledgement" />
                    <Button Classes="nav" Content="⚙  Settings…" Click="Settings_Click" ToolTip.Tip="Configure the Ollama server endpoint" />
                    <Button Classes="nav" Content="🔌  MCP servers…" Click="McpServers_Click" ToolTip.Tip="Configure external MCP tools for Code tasks" />
                    <Button Classes="nav" Content="⇧⇩  Chat backups…" ToolTip.Tip="Import or export conversation backups">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Export all chats…" Click="ExportBackup_Click" />
                                <MenuItem Header="Import chats…" Click="ImportBackup_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="nav" Content="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
                <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,13,4,3">
                    <StackPanel Spacing="5">
                        <TextBlock Text="PROJECT" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectLabel}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding ContextLabel}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Classes="soft" Content="Project actions…" HorizontalAlignment="Stretch" FontSize="10" IsEnabled="{Binding CanOpenProjectActions}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Share workspace with OpenAI" ToggleType="CheckBox" IsChecked="{Binding IncludeProjectContextForHosted, Mode=TwoWay}" IsEnabled="{Binding IsOpenAIModel}" ToolTip.Tip="Project files and instructions from this conversation's attached workspace may be sent to OpenAI. Tool and command results are governed by OpenAI Code task consent." />
                                    <MenuItem Header="Git status and changes…" IsEnabled="{Binding HasProject}" Click="GitStatus_Click" />
                                    <MenuItem Header="{Binding FileChangesLabel}" IsEnabled="{Binding CanReviewFileChanges}" Click="ReviewFileChanges_Click" />
                                    <MenuItem Header="{Binding ProjectTrustLabel}" IsEnabled="{Binding CanManageProjectTrust}" Click="ToggleProjectTrust_Click" ToolTip.Tip="{Binding ProjectTrustTooltip}" />
                                    <MenuItem Header="Command permissions…" IsEnabled="{Binding HasProject}" Click="ProjectCommandPermissions_Click" ToolTip.Tip="Choose whether exact saved command rules may skip approval for this project" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#89B895" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="62,Auto,*,Auto,Auto">
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding ConversationTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding MessageCountLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding CompactionStatusLabel}" IsVisible="{Binding HasCompactionSummary}" Foreground="#89B895" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ComboBox x:Name="ModelPicker" Grid.Column="1" Width="225" IsVisible="{Binding HasModels}" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" DropDownOpened="ModelPicker_DropDownOpened" AutomationProperties.Name="Model picker">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelChoice">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Width="225" IsVisible="{Binding IsModelPickerPlaceholderVisible}" Text="{Binding ModelPickerPlaceholder}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="The model selector appears when at least one model is available." />
                    <ComboBox Grid.Column="2" Width="96" ItemsSource="{Binding ContextSizes}" SelectedValue="{Binding ContextSize, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" IsEnabled="{Binding IsLocalModel}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" ToolTip.Tip="Per-conversation context for local Ollama models; hosted providers control their context windows.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContextSizeChoice">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="3" Classes="soft" Content="{Binding PlanModeLabel}" Command="{Binding TogglePlanModeCommand}" ToolTip.Tip="{Binding ConversationModeCycleTooltip}" />
                    <Button Grid.Column="4" Classes="soft" Content="{Binding CodeTaskLabel}" Command="{Binding ToggleCodeTaskCommand}" ToolTip.Tip="{Binding CodeTaskTooltip}" />
                    <ComboBox x:Name="AgentProfileSelectionComboBox" Grid.Column="5" Width="124" ItemsSource="{Binding AgentProfiles}" SelectedValue="{Binding SelectedAgentProfileName, Mode=TwoWay}" SelectedValueBinding="{Binding Name}" IsEnabled="{Binding IsCodeTask}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" ToolTip.Tip="Choose the Build or Plan primary agent, or a reusable profile. Ctrl+Shift+A toggles Build and Plan. Plan can inspect files but cannot edit, run commands, call MCP, or delegate.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AgentProfileChoice">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="6" Width="105" ItemsSource="{Binding OutputStyles}" SelectedValue="{Binding OutputStyle, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" ToolTip.Tip="Choose how detailed replies should be. Does not change tools or permissions.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutputStyleChoice">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="MoreButton" Grid.Column="7" Classes="soft" Content="More" ToolTip.Tip="Conversation and model actions">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{Binding PinLabel}" Command="{Binding TogglePinCommand}" />
                                <MenuItem Header="{Binding ArchiveLabel}" Command="{Binding ArchiveConversationCommand}" />
                                <MenuItem Header="Export conversation…">
                                    <MenuItem Header="Markdown…" Click="ExportConversation_Click" />
                                    <MenuItem Header="Standalone HTML…" Click="ExportConversationHtml_Click" />
                                </MenuItem>
                                <MenuItem Header="Manage agent profiles…" Click="ManageAgentProfiles_Click" />
                                <MenuItem Header="Open agent profiles folder" Click="OpenAgentProfiles_Click" />
                                <MenuItem Header="Reading width">
                                    <MenuItem Header="Compact · 640 px" IsChecked="{Binding IsCompactReadingWidth, Mode=OneWay}" Click="ReadingWidth_Click" Tag="640" ToggleType="Radio" />
                                    <MenuItem Header="Standard · 800 px" IsChecked="{Binding IsStandardReadingWidth, Mode=OneWay}" Click="ReadingWidth_Click" Tag="800" ToggleType="Radio" />
                                    <MenuItem Header="Wide · 960 px" IsChecked="{Binding IsWideReadingWidth, Mode=OneWay}" Click="ReadingWidth_Click" Tag="960" ToggleType="Radio" />
                                    <MenuItem Header="Full width" IsChecked="{Binding IsFullReadingWidth, Mode=OneWay}" Click="ReadingWidth_Click" Tag="0" ToggleType="Radio" />
                                </MenuItem>
                                <MenuItem Header="Font family">
                                    <MenuItem Header="Inter" IsChecked="{Binding IsFontInter, Mode=OneWay}" Click="FontFamily_Click" Tag="Inter" ToggleType="Radio" />
                                    <MenuItem Header="Segoe UI" IsChecked="{Binding IsFontSegoeUi, Mode=OneWay}" Click="FontFamily_Click" Tag="Segoe UI" ToggleType="Radio" />
                                    <MenuItem Header="Arial" IsChecked="{Binding IsFontArial, Mode=OneWay}" Click="FontFamily_Click" Tag="Arial" ToggleType="Radio" />
                                    <MenuItem Header="Consolas" IsChecked="{Binding IsFontConsolas, Mode=OneWay}" Click="FontFamily_Click" Tag="Consolas" ToggleType="Radio" />
                                    <MenuItem Header="Aptos" IsChecked="{Binding IsFontAptos, Mode=OneWay}" Click="FontFamily_Click" Tag="Aptos" ToggleType="Radio" />
                                    <MenuItem Header="Calibri" IsChecked="{Binding IsFontCalibri, Mode=OneWay}" Click="FontFamily_Click" Tag="Calibri" ToggleType="Radio" />
                                    <MenuItem Header="Verdana" IsChecked="{Binding IsFontVerdana, Mode=OneWay}" Click="FontFamily_Click" Tag="Verdana" ToggleType="Radio" />
                                    <MenuItem Header="Tahoma" IsChecked="{Binding IsFontTahoma, Mode=OneWay}" Click="FontFamily_Click" Tag="Tahoma" ToggleType="Radio" />
                                    <MenuItem Header="Georgia" IsChecked="{Binding IsFontGeorgia, Mode=OneWay}" Click="FontFamily_Click" Tag="Georgia" ToggleType="Radio" />
                                    <MenuItem Header="Cascadia Code" IsChecked="{Binding IsFontCascadiaCode, Mode=OneWay}" Click="FontFamily_Click" Tag="Cascadia Code" ToggleType="Radio" />
                                </MenuItem>
                                <MenuItem Header="Font size">
                                    <MenuItem Header="10" IsChecked="{Binding IsFontSize10, Mode=OneWay}" Click="FontSize_Click" Tag="10" ToggleType="Radio" />
                                    <MenuItem Header="11" IsChecked="{Binding IsFontSize11, Mode=OneWay}" Click="FontSize_Click" Tag="11" ToggleType="Radio" />
                                    <MenuItem Header="12 · Smaller" IsChecked="{Binding IsFontSize12, Mode=OneWay}" Click="FontSize_Click" Tag="12" ToggleType="Radio" />
                                    <MenuItem Header="13" IsChecked="{Binding IsFontSize13, Mode=OneWay}" Click="FontSize_Click" Tag="13" ToggleType="Radio" />
                                    <MenuItem Header="14 · Default" IsChecked="{Binding IsFontSize14, Mode=OneWay}" Click="FontSize_Click" Tag="14" ToggleType="Radio" />
                                    <MenuItem Header="15" IsChecked="{Binding IsFontSize15, Mode=OneWay}" Click="FontSize_Click" Tag="15" ToggleType="Radio" />
                                    <MenuItem Header="16 · Larger" IsChecked="{Binding IsFontSize16, Mode=OneWay}" Click="FontSize_Click" Tag="16" ToggleType="Radio" />
                                    <MenuItem Header="18" IsChecked="{Binding IsFontSize18, Mode=OneWay}" Click="FontSize_Click" Tag="18" ToggleType="Radio" />
                                    <MenuItem Header="20" IsChecked="{Binding IsFontSize20, Mode=OneWay}" Click="FontSize_Click" Tag="20" ToggleType="Radio" />
                                    <MenuItem Header="22 · Largest" IsChecked="{Binding IsFontSize22, Mode=OneWay}" Click="FontSize_Click" Tag="22" ToggleType="Radio" />
                                    <MenuItem Header="24" IsChecked="{Binding IsFontSize24, Mode=OneWay}" Click="FontSize_Click" Tag="24" ToggleType="Radio" />
                                    <MenuItem Header="28" IsChecked="{Binding IsFontSize28, Mode=OneWay}" Click="FontSize_Click" Tag="28" ToggleType="Radio" />
                                    <MenuItem Header="32 · Extra large" IsChecked="{Binding IsFontSize32, Mode=OneWay}" Click="FontSize_Click" Tag="32" ToggleType="Radio" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Advanced model settings…" Click="AdvancedModelSettings_Click" IsEnabled="{Binding CanOpenAdvancedModelSettings}" />
                                <MenuItem Header="Thinking mode" ToggleType="CheckBox" IsChecked="{Binding ThinkEnabled, Mode=TwoWay}" IsEnabled="{Binding IsLocalModel}" />
                                <MenuItem Header="Loaded models and memory…" Click="LoadedModels_Click" />
                                <MenuItem Header="Prompt templates…" Click="PromptTemplates_Click" />
                                <MenuItem Header="{Binding LastPromptContextLabel}" IsEnabled="{Binding HasLastPromptContext}" Click="PromptContext_Click" />
                                <Separator />
                                <MenuItem Header="Compact conversation…" Click="CompactConversation_Click" />
                                <MenuItem Header="Restore full history" IsVisible="{Binding HasCompactionSummary}" Click="RestoreFullHistory_Click" />
                                <Separator />
                                <MenuItem Header="{Binding TaskChecklistLabel}" IsVisible="{Binding ShouldShowTaskChecklist}" Click="TaskChecklist_Click" />
                                <MenuItem Header="Command permissions…" IsEnabled="{Binding HasProject}" Click="ProjectCommandPermissions_Click" ToolTip.Tip="Choose Auto, allowlist, read-only, or ask-every-time approval for this workspace" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Popup x:Name="TaskChecklistPopup" PlacementTarget="{Binding #MoreButton}" Placement="Bottom" IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Width="520" MaxHeight="420">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{Binding TaskChecklistLabel}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="For multi-step Code tasks, the model can maintain these steps. Edit or reorder them when needed; checklist text never grants permissions." IsVisible="{Binding HasTaskChecklist}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="The checklist will appear when a multi-step task needs one." IsVisible="{Binding IsTaskChecklistEmpty}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TaskChecklistItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:TaskChecklistItem">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                                                    <Button Content="{Binding DisplayStatus}" Classes="soft" Tag="{Binding}" Click="TaskChecklistStatus_Click" IsEnabled="{Binding $parent[Window].DataContext.CanEditTaskChecklist}" ToolTip.Tip="Cycle between to do, in progress, and done" />
                                                    <TextBox Grid.Column="1" Text="{Binding Text}" MaxLength="240" IsEnabled="{Binding $parent[Window].DataContext.CanEditTaskChecklist}" Tag="{Binding}" LostFocus="TaskChecklistText_LostFocus" VerticalContentAlignment="Center" />
                                                    <Button Grid.Column="2" Content="↑" Classes="soft" Tag="{Binding}" Click="TaskChecklistMoveUp_Click" IsEnabled="{Binding $parent[Window].DataContext.CanEditTaskChecklist}" ToolTip.Tip="Move this step up" />
                                                    <Button Grid.Column="3" Content="↓" Classes="soft" Tag="{Binding}" Click="TaskChecklistMoveDown_Click" IsEnabled="{Binding $parent[Window].DataContext.CanEditTaskChecklist}" ToolTip.Tip="Move this step down" />
                                                    <Button Grid.Column="4" Content="×" Classes="soft" Tag="{Binding}" Click="TaskChecklistRemove_Click" IsEnabled="{Binding $parent[Window].DataContext.CanEditTaskChecklist}" ToolTip.Tip="Remove this step" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Content="＋ Add step" Classes="soft" HorizontalAlignment="Left" Click="AddTaskChecklistItem_Click" IsEnabled="{Binding CanAddTaskChecklistItem}" ToolTip.Tip="Add a checklist step" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <Border Grid.Row="1" IsVisible="{Binding ShowCodeTaskUnavailableReason}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,7">
                <Grid ColumnDefinitions="*">
                    <TextBlock Text="{Binding CodeTaskUnavailableReason}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="ConversationScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ConversationScrollViewer_ScrollChanged">
                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" Margin="0,22" MaxWidth="{Binding ReadingWidth}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ChatMessage">
                        <Grid Margin="0,0,0,20">
                            <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="{Binding ReadingWidth}" Margin="48,0,24,0" Spacing="4">
                                <Border HorizontalAlignment="Right" Padding="16,10" CornerRadius="15" Background="{DynamicResource UserBubbleBrush}">
                                    <md:MarkdownScrollViewer Markdown="{Binding Content}" SelectionEnabled="True" MaxWidth="{Binding $parent[Window].DataContext.ReadingWidth}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                    <Button Content="Steer" Classes="soft" Padding="7,3" FontSize="10" IsVisible="{Binding IsQueued}" Tag="{Binding}" Click="PrioritizeQueuedMessage_Click" ToolTip.Tip="Run this queued prompt next after the current response" />
                                    <Button Content="×" Classes="soft" Padding="7,3" FontSize="10" IsVisible="{Binding IsQueued}" Tag="{Binding}" Click="CancelQueuedMessage_Click" ToolTip.Tip="Remove this queued prompt" />
                                    <Button Content="⋯" Classes="soft" Padding="7,3" FontSize="10" ToolTip.Tip="Prompt actions">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Edit message" Tag="{Binding}" Click="EditPromptMenu_Click" />
                                                <MenuItem Header="Open in side chat" Tag="{Binding}" Click="OpenSideChat_Click" />
                                                <Separator />
                                                <MenuItem Header="Turn off queuing" IsVisible="{Binding $parent[Window].DataContext.IsQueueEnabled}" Tag="{Binding}" Click="TurnOffQueuing_Click" />
                                                <MenuItem Header="Turn on queuing" IsVisible="{Binding $parent[Window].DataContext.IsQueueDisabled}" Tag="{Binding}" Click="TurnOnQueuing_Click" />
                                                <Separator />
                                                <MenuItem Header="Summarize up to here" Command="{Binding $parent[Window].DataContext.SummarizeConversationUpToCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Summarize from here" Command="{Binding $parent[Window].DataContext.SummarizeConversationFromCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Rewind" Command="{Binding $parent[Window].DataContext.RewindConversationCommand}" CommandParameter="{Binding MessageIndex}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsAssistant}" HorizontalAlignment="Stretch" MaxWidth="{Binding $parent[Window].DataContext.ReadingWidth}" Margin="24,0,24,0" Spacing="8">
                                <Expander Header="Model thinking" IsExpanded="False" IsVisible="{Binding HasThinking}" ToolTip.Tip="Thinking returned separately by the local Ollama model. It is saved with this reply but excluded from future prompts.">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" MaxWidth="{Binding $parent[Window].DataContext.ReadingWidth}">
                                        <md:MarkdownScrollViewer Markdown="{Binding Thinking}" SelectionEnabled="True" MaxWidth="{Binding $parent[Window].DataContext.ReadingWidth}" />
                                    </Border>
                                </Expander>
                                <md:MarkdownScrollViewer Markdown="{Binding DisplayContent}" SelectionEnabled="True" MaxWidth="{Binding $parent[Window].DataContext.ReadingWidth}" />
                                <Expander x:Name="CommandToolOutputsExpander" Header="{Binding CommandToolOutputsHeader}" IsExpanded="False" IsVisible="{Binding HasToolOutputs}" ToolTip.Tip="Expand to inspect each tool action and its output.">
                                    <ItemsControl ItemsSource="{Binding CommandToolOutputs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ChatToolOutput">
                                                <StackPanel Margin="0,2,0,2" Spacing="0">
                                                    <ToggleButton x:Name="ToolOutputToggle" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch">
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                                <TextBlock Text="›_" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="⌄" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </ToggleButton>
                                                    <Border IsVisible="{Binding #ToolOutputToggle.IsChecked}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="10" MaxHeight="360" Margin="0,-1,0,0">
                                                        <TextBox Text="{Binding Content}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="{Binding $parent[Window].DataContext.UiFontSize}" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <TextBlock Text="{Binding HostedUsageLabel}" IsVisible="{Binding HasHostedUsage}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,0,0,0" ToolTip.Tip="Sum of provider-reported token usage across completed OpenAI Code task requests for this reply. Missing provider reports are marked as a lower bound." />
                                <TextBlock Text="{Binding GenerationStatsLabel}" IsVisible="{Binding HasGenerationStats}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,0,0,0" ToolTip.Tip="Generation stats reported by Ollama; first-token time is measured by Codev." />
                                <Button Content="Summarize up to here" Classes="soft" HorizontalAlignment="Left" Padding="7,3" FontSize="10"
                                        Command="{Binding $parent[Window].DataContext.SummarizeConversationUpToCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Summarize complete exchanges through this reply; keep later messages verbatim" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="InlineApprovalPanel" Grid.Row="3" IsVisible="False" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8,16,8" MaxHeight="390">
                <ContentControl x:Name="InlineApprovalContent" />
            </Border>
            <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,8,22,8">
                <Grid>
                    <StackPanel MaxWidth="{Binding ReadingWidth}" HorizontalAlignment="Stretch" Spacing="4">
                        <Expander x:Name="BackgroundCommandsExpander" Header="{Binding BackgroundCommandsHeader}" IsExpanded="False" IsVisible="{Binding HasBackgroundCommands}" ToolTip.Tip="Commands started in the background remain visible here until they exit or you stop them.">
                            <ItemsControl ItemsSource="{Binding BackgroundCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:BackgroundCommandSnapshot">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Command}" />
                                            <Button Grid.Column="1" Content="Stop" Classes="soft" Padding="8,3" IsEnabled="{Binding IsRunning}" Command="{Binding $parent[Window].DataContext.StopBackgroundCommand}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="ComposerTextBox" Classes="composer" AcceptsReturn="True" MinHeight="64" MaxHeight="180" TextWrapping="Wrap" FontFamily="{Binding UiFontFamily}" FontSize="{Binding UiFontSize}" Watermark="Message Codev… · drop project files to attach" VerticalContentAlignment="Top" Text="{Binding Draft, Mode=TwoWay}" TextChanged="Composer_TextChanged" />
                            <Button Grid.Column="1" Classes="composer-send" Content="{Binding SendButtonLabel}" ToolTip.Tip="Send prompt or queue follow-up; with an empty composer, stop generation" FontSize="21" Width="36" Height="34" VerticalAlignment="Bottom" Margin="-49,0,8,9" Command="{Binding SendCommand}" />
                            <Popup x:Name="FileMentionPopup" PlacementTarget="{Binding #ComposerTextBox}" Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Width="480">
                                    <ListBox x:Name="FileMentionListBox" MaxHeight="220">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Content="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="FileMentionSuggestion_Click" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <Popup x:Name="SlashCommandPopup" PlacementTarget="{Binding #ComposerTextBox}" Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Width="480">
                                    <ListBox x:Name="SlashCommandListBox" MaxHeight="260">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:SlashCommandDefinition">
                                                <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="7,6" Click="SlashCommandSuggestion_Click">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ScopeLabel}" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PendingDiffComments}" IsVisible="{Binding HasPendingDiffComments}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:GitDiffComment">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,6,4" ToolTip.Tip="{Binding SelectedDiff}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding RelativePath}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Comment}" FontSize="10" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Content="×" Padding="3,0" Background="Transparent" BorderThickness="0" Command="{Binding $parent[Window].DataContext.RemoveDiffCommentCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove this unsent diff comment" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="soft" Content="＋ Context" Padding="8,4" FontSize="10" ToolTip.Tip="Attach a project or choose files to include with this conversation">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Open project folder…" Click="AttachProject_Click" />
                                            <MenuItem Header="Browse project files…" IsEnabled="{Binding HasProject}" Click="BrowseProjectFiles_Click" />
                                            <MenuItem Header="Add files to context…" IsEnabled="{Binding HasProject}" Click="AddContextFiles_Click" />
                                            <Separator />
                                            <MenuItem Header="Include repository map" ToggleType="CheckBox" IsChecked="{Binding IncludeRepoMap, Mode=TwoWay}" IsEnabled="{Binding CanIncludeRepoMap}" />
                                            <MenuItem Header="Clear selected files" IsVisible="{Binding HasSelectedContextFiles}" Command="{Binding ClearContextFilesCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="ProjectCommandModeButton" Classes="soft" Content="{Binding ProjectCommandPermissionModeLabel}" Padding="8,4" FontSize="10" IsVisible="{Binding HasProject}" IsEnabled="{Binding CanPersistProjectCommandPermissions}" ToolTip.Tip="Command mode is saved per project. Auto runs commands without approval unless their exact text has a saved deny rule. Commands use your account permissions and are not sandboxed to the project folder.">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Auto · approve unless denied" Tag="Auto" Click="ProjectCommandMode_Click" />
                                            <MenuItem Header="Allowlist · run saved exact commands" Tag="Allowlist" Click="ProjectCommandMode_Click" />
                                            <MenuItem Header="Read-only · allow recognized inspections" Tag="ReadOnly" Click="ProjectCommandMode_Click" />
                                            <MenuItem Header="Ask every time" Tag="AskEveryTime" Click="ProjectCommandMode_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock Text="{Binding ContextLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ContextEstimateLabel}" />
                            </StackPanel>
                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedContextFiles}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,5,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding}" FontSize="10" VerticalAlignment="Center" />
                                            <Button Content="×" Padding="2,0" Background="Transparent" BorderThickness="0" Command="{Binding $parent[Window].DataContext.RemoveContextFileCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove this file from chat context" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
                                <TextBlock Text="{Binding ContextActionStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" IsVisible="{Binding HasContextActionStatus}" />
                                <TextBlock Text="{Binding UnknownContextWarningLabel}" Foreground="#D6A66D" FontSize="9" TextWrapping="Wrap" IsVisible="{Binding ShouldWarnUnknownContext}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShouldOfferCompaction}">
                                    <TextBlock Text="{Binding CompactionOfferLabel}" Foreground="#D6A66D" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Content="Compact now" Classes="soft" Padding="6,2" FontSize="9" Click="CompactConversation_Click" ToolTip.Tip="Review a summary of older turns before using it in future prompts" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasQueuedTurns}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding QueueStatusLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button IsVisible="{Binding IsQueuePaused}" Content="Resume saved queue" Command="{Binding ResumeQueueCommand}" Classes="soft" Padding="7,3" FontSize="10" />
                                <Button IsVisible="{Binding HasQueuedTurns}" Content="Cancel queued" Command="{Binding CancelQueuedCommand}" Classes="soft" Padding="7,3" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
