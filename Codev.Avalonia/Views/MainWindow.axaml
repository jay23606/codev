<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codev.Avalonia.ViewModels"
        xmlns:core="using:Codev"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        x:Class="Codev.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        KeyDown="MainWindow_KeyDown"
        Title="Codev"
        Width="1440" Height="960" MinWidth="1000" MinHeight="650"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.soft">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.soft:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBox.composer">
            <Setter Property="Background" Value="{DynamicResource ComposerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15,13" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="258,*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,17,12,12">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Grid ColumnDefinitions="30,*" Margin="5,0,3,20">
                    <Border Width="25" Height="25" CornerRadius="8" Background="#D97757" VerticalAlignment="Center">
                        <TextBlock Text="c" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="codev" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="YOUR LOCAL CODING SPACE" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="1" Classes="nav" Content="＋   New conversation" Command="{Binding NewConversationCommand}" Background="#D97757" Foreground="White" Margin="0,0,0,4" />
                <TextBox x:Name="SearchTextBox" Grid.Row="2" Classes="search" Watermark="⌕  Search conversations" Text="{Binding SearchText, Mode=TwoWay}" Margin="0,0,0,14" />
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="PINNED" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="9,4,0,5" />
                        <ItemsControl ItemsSource="{Binding PinnedConversations}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Conversation">
                                <Button Classes="nav" Content="{Binding Title}" Command="{Binding $parent[Window].DataContext.SelectConversationCommand}" CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Fork conversation" Tag="{Binding}" Click="ForkConversation_Click" />
                                            <MenuItem Header="Rename…" Tag="{Binding}" Click="RenameConversation_Click" />
                                            <MenuItem Header="Archive / restore" Tag="{Binding}" Click="ArchiveConversation_Click" />
                                            <MenuItem Header="Delete permanently…" Tag="{Binding}" Click="DeleteConversation_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="nav" Content="{Binding ArchiveViewLabel}" Command="{Binding ToggleArchiveViewCommand}" Margin="1,12,0,0" />
                        <TextBlock Text="RECENTS" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="9,8,0,5" />
                        <ItemsControl ItemsSource="{Binding RecentConversations}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:Conversation">
                                <Button Classes="nav" Content="{Binding Title}" Command="{Binding $parent[Window].DataContext.SelectConversationCommand}" CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Fork conversation" Tag="{Binding}" Click="ForkConversation_Click" />
                                            <MenuItem Header="Rename…" Tag="{Binding}" Click="RenameConversation_Click" />
                                            <MenuItem Header="Archive / restore" Tag="{Binding}" Click="ArchiveConversation_Click" />
                                            <MenuItem Header="Delete permanently…" Tag="{Binding}" Click="DeleteConversation_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="4" Spacing="1" Margin="0,0,0,8">
                    <Button Classes="nav" Content="☁  Connect hosted models…" Click="ConfigureCloudProvider_Click" ToolTip.Tip="Connect OpenAI or Anthropic using an API key; cloud requests require an explicit acknowledgement" />
                    <Button Classes="nav" Content="⚙  Settings…" Click="Settings_Click" ToolTip.Tip="Configure the Ollama server endpoint" />
                    <Button Classes="nav" Content="⇩  Export all chats…" Click="ExportBackup_Click" ToolTip.Tip="Save all conversations as a portable local JSON backup" />
                    <Button Classes="nav" Content="⇧  Import chats…" Click="ImportBackup_Click" ToolTip.Tip="Add conversations from a Codev JSON backup without replacing existing history" />
                    <Button Classes="nav" Content="{Binding ThemeLabel}" Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
                <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,13,4,3">
                    <StackPanel Spacing="5">
                        <TextBlock Text="PROJECT" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProjectLabel}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding ContextLabel}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        <Button Classes="soft" Content="Git status &amp; changes…" HorizontalAlignment="Stretch" FontSize="10" IsEnabled="{Binding HasProject}" Click="GitStatus_Click" ToolTip.Tip="Review local branch and project changes; Codev never pushes commits." />
                        <Button Classes="soft" Content="{Binding FileChangesLabel}" HorizontalAlignment="Stretch" FontSize="10" IsEnabled="{Binding CanReviewFileChanges}" Click="ReviewFileChanges_Click" ToolTip.Tip="Review or restore files changed by this conversation." />
                        <Button Classes="soft" Content="{Binding ProjectTrustLabel}" HorizontalAlignment="Stretch" FontSize="10" IsEnabled="{Binding CanManageProjectTrust}" Click="ToggleProjectTrust_Click" ToolTip.Tip="{Binding ProjectTrustTooltip}" />
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#89B895" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="62,*,Auto">
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding ConversationTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding MessageCountLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding CompactionStatusLabel}" IsVisible="{Binding HasCompactionSummary}" Foreground="#89B895" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ComboBox x:Name="ModelPicker" Grid.Column="1" Width="250" IsVisible="{Binding HasModels}" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" DropDownOpened="ModelPicker_DropDownOpened">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelChoice">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Width="250" IsVisible="{Binding IsModelPickerPlaceholderVisible}" Text="{Binding ModelPickerPlaceholder}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="The model picker appears after Ollama's installed models are loaded." />
                    <ComboBox Grid.Column="2" Width="112" ItemsSource="{Binding ContextSizes}" SelectedValue="{Binding ContextSize, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" IsEnabled="{Binding IsLocalModel}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" ToolTip.Tip="Per-conversation context for local Ollama models; hosted providers control their context windows.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContextSizeChoice">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="3" Classes="soft" Content="{Binding PlanModeLabel}" Command="{Binding TogglePlanModeCommand}" ToolTip.Tip="Ctrl+Shift+M cycles Chat, Plan, and Code task. Plan mode cannot edit files or run commands." />
                    <Button Grid.Column="4" Classes="soft" Content="{Binding CodeTaskLabel}" Command="{Binding ToggleCodeTaskCommand}" ToolTip.Tip="Ctrl+Shift+M cycles Chat, Plan, and Code task. Code task requires a trusted project and local Ollama; file changes and every shell command still need approval." />
                    <Button Grid.Column="5" Classes="soft" Content="{Binding PinLabel}" Command="{Binding TogglePinCommand}" />
                    <Button Grid.Column="6" Classes="soft" Content="{Binding ArchiveLabel}" Command="{Binding ArchiveConversationCommand}" />
                    <Button Grid.Column="7" Classes="soft" Content="⇩ Export" Click="ExportConversation_Click" ToolTip.Tip="Save this conversation as a Markdown file" />
                    <ComboBox Grid.Column="8" Width="120" ItemsSource="{Binding OutputStyles}" SelectedValue="{Binding OutputStyle, Mode=TwoWay}" SelectedValueBinding="{Binding Value}" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" ToolTip.Tip="Choose how detailed replies should be. Does not change tools or permissions.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutputStyleChoice">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleButton Grid.Column="9" Classes="soft" Content="Think" IsChecked="{Binding ThinkEnabled, Mode=TwoWay}" IsVisible="{Binding IsLocalModel}" ToolTip.Tip="Ask a thinking-capable Ollama model to return its separate thinking trace. The trace stays collapsed below the reply. Unsupported models use their default behavior." />
                    <Button Grid.Column="10" Classes="soft" Content="Memory" Click="LoadedModels_Click" ToolTip.Tip="See models currently loaded by Ollama and their reported memory use; unload a model when the queue is idle." />
                    <Button Grid.Column="11" Classes="soft" Content="Compact" Click="CompactConversation_Click" ToolTip.Tip="Summarize older turns for future prompts, review the summary, and keep the full transcript." />
                    <Button Grid.Column="12" Classes="soft" Content="Full history" IsVisible="{Binding HasCompactionSummary}" Click="RestoreFullHistory_Click" ToolTip.Tip="Remove the summary and use the complete transcript in future prompts again." />
                </Grid>
            </Border>
            <ScrollViewer x:Name="ConversationScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ConversationScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="0,22">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ChatMessage">
                        <Grid Margin="0,0,0,20">
                            <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="760" Margin="48,0,24,0" Spacing="4">
                                <Border HorizontalAlignment="Right" Padding="16,10" CornerRadius="15" Background="{DynamicResource UserBubbleBrush}">
                                    <md:MarkdownScrollViewer Markdown="{Binding Content}" SelectionEnabled="True" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                    <Button Content="Summarize up to here" Classes="soft" Padding="7,3" FontSize="10"
                                            Command="{Binding $parent[Window].DataContext.SummarizeConversationUpToCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Summarize complete exchanges before this prompt; keep this prompt and later messages verbatim" />
                                    <Button Content="Rewind" Classes="soft" Padding="7,3" FontSize="10"
                                            Command="{Binding $parent[Window].DataContext.RewindConversationCommand}"
                                            CommandParameter="{Binding MessageIndex}"
                                            ToolTip.Tip="Restore conversation to before this prompt; project files stay unchanged" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsAssistant}" HorizontalAlignment="Left" MaxWidth="1050" Margin="24,0,24,0" Spacing="8">
                                <Expander Header="Model thinking" IsExpanded="False" IsVisible="{Binding HasThinking}" ToolTip.Tip="Thinking returned separately by the local Ollama model. It is saved with this reply but excluded from future prompts.">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <md:MarkdownScrollViewer Markdown="{Binding Thinking}" SelectionEnabled="True" />
                                    </Border>
                                </Expander>
                                <md:MarkdownScrollViewer Markdown="{Binding Content}" SelectionEnabled="True" />
                                <TextBlock Text="{Binding GenerationStatsLabel}" IsVisible="{Binding HasGenerationStats}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,0,0,0" ToolTip.Tip="Generation stats reported by Ollama; first-token time is measured by Codev." />
                                <Button Content="Summarize up to here" Classes="soft" HorizontalAlignment="Left" Padding="7,3" FontSize="10"
                                        Command="{Binding $parent[Window].DataContext.SummarizeConversationUpToCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Summarize complete exchanges through this reply; keep later messages verbatim" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14,22,18">
                        <Grid ColumnDefinitions="*,790,*">
                    <StackPanel Grid.Column="1" Spacing="7">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="ComposerTextBox" Classes="composer" AcceptsReturn="True" MinHeight="84" MaxHeight="180" TextWrapping="Wrap" Watermark="Message Codev…" VerticalContentAlignment="Top" Text="{Binding Draft, Mode=TwoWay}" TextChanged="Composer_TextChanged" />
                            <Button Grid.Column="1" Content="{Binding SendButtonLabel}" ToolTip.Tip="Send prompt or queue follow-up; with an empty composer, stop generation" FontSize="18" Width="40" Height="38" VerticalAlignment="Bottom" Margin="-51,0,9,9" Background="#D97757" Foreground="White" BorderThickness="0" CornerRadius="8" Command="{Binding SendCommand}" />
                            <Popup x:Name="FileMentionPopup" PlacementTarget="{Binding #ComposerTextBox}" Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Width="480">
                                    <ListBox x:Name="FileMentionListBox" MaxHeight="220">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Content="{Binding}" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="FileMentionSuggestion_Click" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <Popup x:Name="SlashCommandPopup" PlacementTarget="{Binding #ComposerTextBox}" Placement="Top" IsLightDismissEnabled="True">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Width="480">
                                    <ListBox x:Name="SlashCommandListBox" MaxHeight="260">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:SlashCommandDefinition">
                                                <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="7,6" Click="SlashCommandSuggestion_Click">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ScopeLabel}" FontSize="8" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PendingDiffComments}" IsVisible="{Binding HasPendingDiffComments}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:GitDiffComment">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,6,4" ToolTip.Tip="{Binding SelectedDiff}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding RelativePath}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="·" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Comment}" FontSize="10" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Content="×" Padding="3,0" Background="Transparent" BorderThickness="0" Command="{Binding $parent[Window].DataContext.RemoveDiffCommentCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove this unsent diff comment" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="soft" Content="Open project" Padding="8,4" FontSize="10" Click="AttachProject_Click" ToolTip.Tip="Attach a local folder as read-only context for this conversation" />
                                <Button Classes="soft" Content="Browse files" Padding="8,4" FontSize="10" IsEnabled="{Binding HasProject}" Click="BrowseProjectFiles_Click" ToolTip.Tip="Filter and preview supported project text files, then add one to chat context" />
                                <Button Classes="soft" Content="＋ Add files" Padding="8,4" FontSize="10" IsEnabled="{Binding HasProject}" Click="AddContextFiles_Click" ToolTip.Tip="Select supported source and text files from the attached project" />
                                <Button Classes="soft" Content="Clear selection" Padding="8,4" FontSize="10" IsVisible="{Binding HasSelectedContextFiles}" Command="{Binding ClearContextFilesCommand}" />
                                <TextBlock Text="{Binding ContextLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                                <CheckBox Content="Include repo map" IsChecked="{Binding IncludeRepoMap, Mode=TwoWay}" IsEnabled="{Binding CanIncludeRepoMap}" FontSize="10" VerticalAlignment="Center" ToolTip.Tip="Attach a compact, bounded project file and symbol outline. Uses the same trust, selection, and hosted-context rules as project files." />
                            </StackPanel>
                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding SelectedContextFiles}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,5,4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding}" FontSize="10" VerticalAlignment="Center" />
                                            <Button Content="×" Padding="2,0" Background="Transparent" BorderThickness="0" Command="{Binding $parent[Window].DataContext.RemoveContextFileCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove this file from chat context" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                                <TextBlock Text="{Binding ContextEstimateLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RepoMapEstimateLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" />
                                <Button Content="{Binding LastPromptContextLabel}" Classes="soft" Padding="6,2" FontSize="9" HorizontalAlignment="Left" IsEnabled="{Binding HasLastPromptContext}" Click="PromptContext_Click" ToolTip.Tip="Inspect normalized messages, the exact request JSON body, and approximate token breakdown from the latest Chat, Plan, or Code task request" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="3">
                                <TextBlock Text="{Binding ContextActionStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" IsVisible="{Binding HasContextActionStatus}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShouldOfferCompaction}">
                                    <TextBlock Text="{Binding CompactionOfferLabel}" Foreground="#D6A66D" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Content="Compact now" Classes="soft" Padding="6,2" FontSize="9" Click="CompactConversation_Click" ToolTip.Tip="Review a summary of older turns before using it in future prompts" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding ProviderStatusLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="·" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding QueueStatusLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="Prompt templates" Classes="soft" Click="PromptTemplates_Click" Padding="7,3" FontSize="10" ToolTip.Tip="Create and manage reusable prompts saved on this device" />
                                <Button IsVisible="{Binding IsQueuePaused}" Content="Resume saved queue" Command="{Binding ResumeQueueCommand}" Classes="soft" Padding="7,3" FontSize="10" />
                                <Button IsVisible="{Binding HasQueuedTurns}" Content="Cancel queued" Command="{Binding CancelQueuedCommand}" Classes="soft" Padding="7,3" FontSize="10" />
                                <TextBlock Text="Enter to send · Shift+Enter for new line · / commands · @ files/rules" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
