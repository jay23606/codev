<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codev.Avalonia.Views.ProjectFileBrowserWindow"
        Title="Browse project files"
        Width="1040" Height="700" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="12">
        <StackPanel Spacing="3">
            <TextBlock Text="Project files" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ProjectPathText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="12">
            <Grid RowDefinitions="Auto,*">
                <TextBox x:Name="FilterTextBox" Watermark="Filter files…" TextChanged="Filter_TextChanged" />
                <ListBox x:Name="FileListBox" Grid.Row="1" Margin="0,8,0,0" SelectionChanged="File_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="PreviewTitle" Text="Select a file to preview" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="FileCountText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" FontSize="10" />
                </Grid>
                <TextBox x:Name="PreviewTextBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="{DynamicResource ComposerBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
            <Button Grid.Column="1" Content="Close" MinWidth="90" Click="Close_Click" />
            <Button x:Name="AddButton" Grid.Column="2" Content="Add to context" MinWidth="120" IsEnabled="False" Click="Add_Click" Background="#D97757" Foreground="White" BorderThickness="0" />
        </Grid>
    </Grid>
</Window>
